# Copy to worker/.env (loaded automatically) or set in the service environment.
# Never commit real values. Everything runs with the SERVICE ROLE key: keep it server-side only.

# ---- Supabase (required) ----------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Stocks: Alpaca (free Basic plan, IEX feed) -----------------------------
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# ALPACA_WS_URL=wss://stream.data.alpaca.markets/v2/iex
# ALPACA_DATA_URL=https://data.alpaca.markets
# Free plan streams at most 30 symbols; extras are polled via REST snapshots.
# ALPACA_MAX_SYMBOLS=30

# ---- Stocks fallback: Finnhub (used when Alpaca keys are absent) -------------
FINNHUB_API_KEY=
# auto = Alpaca if keys present, else Finnhub. Or force: alpaca | finnhub
# STOCK_PROVIDER=auto

# ---- Crypto -----------------------------------------------------------------
# binance (websocket, default) | coingecko (REST polling fallback)
# CRYPTO_PROVIDER=binance
# Binance.com can be geo-restricted (HTTP 451) from the US. Alternative:
# BINANCE_WS_URL=wss://stream.binance.us:9443
# BINANCE_WS_URL=wss://stream.binance.com:9443
# COINGECKO_API_URL=https://api.coingecko.com/api/v3
# COINGECKO_API_KEY=            # optional free "Demo" key
# COINGECKO_IDS=PEPE:pepe,FOO:foo-coin   # extra SYMBOL:coingecko-id pairs
# COINGECKO_POLL_MS=300000     # ~8.6k calls/month, inside the 10k Demo credits

# ---- Tunables (defaults shown) ----------------------------------------------
# UNIVERSE_REFRESH_MS=60000     # how often to re-read holdings + watchlist
# WRITE_INTERVAL_MS=2000        # max one prices upsert per symbol per interval
# WRITE_BATCH_SIZE=200
# OVERFLOW_POLL_MS=60000        # REST polling cadence for symbols beyond the WS limit
# ALERT_COOLDOWN_MS=21600000    # 6h between repeat alerts for the same target
# HEARTBEAT_MS=20000
# HEALTH_LOG_MS=60000
# BACKOFF_BASE_MS=1000
# BACKOFF_MAX_MS=60000
# LOG_LEVEL=info                # debug | info | warn | error

# ---- Phase 4: news, Claude scoring, alerts ------------------------------------
# NEWS_ENABLED=true
# SEC EDGAR requires a User-Agent with real contact info. Set this to an address you own.
NEWS_CONTACT_EMAIL=
# Claude relevance scoring (Haiku). Without a key, news is stored but not scored and no news alerts are raised.
ANTHROPIC_API_KEY=
# NEWS_SCORING_MODEL=claude-haiku-5-5
# NEWS_DAILY_TOKEN_BUDGET=500000      # input+output tokens per UTC day; scoring stops when reached (~$3/mo worst case)
# NEWS_MAX_BATCH=20                   # items per Claude request
# NEWS_SCORE_INTERVAL_MS=120000       # how often to score pending items and generate alerts
# NEWS_ALERT_THRESHOLD=60             # min relevance (0-100) for a holdings/watchlist alert
# NEWS_MACRO_ALERT_THRESHOLD=80       # min relevance for market-wide catalyst alerts (everyone)
# NEWS_MAX_ALERTS_PER_USER_PER_DAY=20
# NEWS_MAX_AGE_HOURS=48               # only score items published within this window
# NEWS_RSS_INTERVAL_MS=300000
# Finnhub news/earnings use FINNHUB_API_KEY above (free tier ~60 calls/min; paced by FINNHUB_MIN_GAP_MS).
# FINNHUB_MIN_GAP_MS=1100
# Optional CryptoPanic (UNVERIFIED endpoint/plan, see README).
# CRYPTOPANIC_API_KEY=
# CRYPTOPANIC_API_URL=https://cryptopanic.com/api/growth/v2/posts/
